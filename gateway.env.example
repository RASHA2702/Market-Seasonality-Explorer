# Settings for the API container. Copy to gateway.env (never commit it), fill in, then:
#   docker compose --profile gateway up -d --build
# One NAME=value per line, without "export". A value with spaces goes in single quotes.

# A merchant: the SHA-256 of its API key (README, "Run it locally", step 1). The key itself is never stored.
Gateway__ApiKeys__Clients__0__ClientId=local-dev
Gateway__ApiKeys__Clients__0__KeySha256=paste-the-64-character-sha256-of-the-key-here

# Signs checkout links: at least 32 random characters, for example from: openssl rand -hex 32
Gateway__Checkout__LinkSecret=change-me

# Reviewer accounts: paste the four lines the reviewer setup command prints, without "export".
#   dotnet run --project src/FiatCryptoGateway.ReviewerSetup
# Gateway__Review__Reviewers__0__Username=
# Gateway__Review__Reviewers__0__DisplayName=
# Gateway__Review__Reviewers__0__PasswordHash=
# Gateway__Review__Reviewers__0__TotpSecret=
