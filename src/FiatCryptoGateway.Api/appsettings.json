{
  "Gateway": {
    "Mode": "Sandbox",
    "AllowRealFundsMovement": false,
    "Pricing": {
      "Version": "sandbox-1",
      "ServiceFeeBasisPoints": 150,
      "SpreadBasisPoints": 50,
      "QuoteTimeToLiveSeconds": 60,
      "PaymentWindowMinutes": 15,
      "MaximumPriceAgeSeconds": 30,
      "PivotCurrency": "USD",
      "MinimumOrderAmount": 10,
      "MaximumOrderAmount": 10000
    },
    "Compliance": {
      "BasicKycLimit": 1000,
      "FullKycLimit": 10000,
      "ManualReviewThreshold": 5000
    },
    "Processing": {
      "Enabled": true,
      "IntervalSeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
