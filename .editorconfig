root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[tests/**.cs]
# Test names read as Scenario_ExpectedOutcome, and inline arrays keep fixtures readable.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
