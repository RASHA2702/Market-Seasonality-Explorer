# Copy to .env for Docker Compose. Never commit a real value.
POSTGRES_DB=gateway
POSTGRES_USER=gateway_app
POSTGRES_PASSWORD=replace-with-a-long-local-development-password

# Only for `docker compose --profile gateway` (the API behind the HTTPS proxy). The defaults suit this machine.
# GATEWAY_DOMAIN=localhost             your domain, once its DNS points at this server
# GATEWAY_TLS=internal                 an email address instead gets a public certificate for GATEWAY_DOMAIN
# GATEWAY_HSTS_SECONDS=0               31536000 once the domain must only be reached over HTTPS
# GATEWAY_REVIEW_FROM=private_ranges   networks that may open /review and /v1/review, e.g. "203.0.113.10/32 10.8.0.0/16"
# GATEWAY_BIND=127.0.0.1               0.0.0.0 to accept connections from other machines
# GATEWAY_HTTP_PORT=80
# GATEWAY_HTTPS_PORT=443
# GATEWAY_EDGE_SUBNET=172.30.10.0/24   change these three together if the subnet is already in use on your machine
# GATEWAY_EDGE_AUTO_RANGE=172.30.10.128/25
# GATEWAY_PROXY_ADDRESS=172.30.10.2

# Database backups (README, "Database backups"). The public key from: age-keygen -o backup-key.txt
# Keep backup-key.txt off this server: without it, no backup can be read, by you or anyone else.
BACKUP_AGE_RECIPIENTS=
# BACKUP_AT=02:30                      every day at this time
# BACKUP_TIME_ZONE=Asia/Kolkata
# BACKUP_KEEP_DAYS=14                  on this machine; keep longer copies off-site
# BACKUP_DIR=./backups
# BACKUP_COPY_TO=offsite:bucket/gateway   an rclone destination, with its credentials in backup.env
